# Змінні для npm run start:otel (Практика 8). Скопіювати: cp .env.example .env
# npm run start:otel підхоплює backend/.env сам (node --env-file-if-exists), npm start його не читає.

# --- OpenTelemetry ---
# Назва сервісу в Tempo, Prometheus (service_name) і Loki
OTEL_SERVICE_NAME=studyswap-api
# OTLP HTTP колектора зі стенду observability-demo; трейси, метрики й логи йдуть на /v1/traces|metrics|logs
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Як часто відправляти метрики, мс (за замовчуванням 10000)
# OTEL_METRIC_EXPORT_INTERVAL=10000
# Файл JSON-логів з trace_id; за замовчуванням backend/data/logs/app.log
# LOG_FILE=./data/logs/app.log

# --- Штучні збої для перевірки дашборду й алертів (за замовчуванням вимкнені) ---
# Частка запитів 0..1, що завершуються 500 InternalError (FAULT_INJECTED); 0.1 — кожен десятий
FAULT_ERROR_RATE=0
# Затримка кожного запиту, мс (не впливає на /health)
FAULT_DELAY_MS=0

# --- Сервер ---
PORT=3000
# Під навантаженням із scripts/load.sh стандартний ліміт (50 запитів за 10 с з одного IP) дає 429
RATE_LIMIT_MAX=100000
